{
    "name": "robertboes/laravel-interlock",
    "description": "Keep the state of an Eloquent model consistent with a declared transition graph.",
    "keywords": [
        "laravel",
        "eloquent",
        "state machine",
        "interlock"
    ],
    "homepage": "https://github.com/robertboes/laravel-interlock",
    "support": {
        "issues": "https://github.com/robertboes/laravel-interlock/issues",
        "source": "https://github.com/robertboes/laravel-interlock",
        "security": "https://github.com/robertboes/laravel-interlock/security/policy"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Robert Boes",
            "email": "robert@hihaho.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/bus": "^12.0|^13.0",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/container": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/events": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.92",
        "symfony/http-kernel": "^7.2|^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.25",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.4|^5.0",
        "pestphp/pest-plugin-laravel": "^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "RobertBoes\\Interlock\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RobertBoes\\Interlock\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RobertBoes\\Interlock\\InterlockServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
