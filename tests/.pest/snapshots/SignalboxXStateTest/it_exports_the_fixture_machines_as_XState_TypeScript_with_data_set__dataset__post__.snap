export const postStatusMachine = {
    "id": "PostStatusMachine",
    "initial": "draft",
    "states": {
        "draft": {
            "on": {
                "submit": {
                    "target": "ready"
                }
            }
        },
        "ready": {
            "on": {
                "schedule": {
                    "target": "scheduled"
                },
                "publish": {
                    "target": "published",
                    "meta": {
                        "trigger": true
                    }
                },
                "retract": {
                    "target": "draft"
                }
            }
        },
        "scheduled": {
            "on": {
                "publish": {
                    "target": "published",
                    "meta": {
                        "trigger": true
                    }
                },
                "retract": {
                    "target": "draft"
                },
                "reschedule": {
                    "target": "scheduled"
                }
            }
        },
        "published": {
            "type": "final"
        }
    }
} as const;

export type PostStatusMachineState = "draft" | "ready" | "scheduled" | "published";

export type PostStatusMachineEvent = { type: "submit" } | { type: "schedule" } | { type: "publish" } | { type: "retract" } | { type: "reschedule" };
