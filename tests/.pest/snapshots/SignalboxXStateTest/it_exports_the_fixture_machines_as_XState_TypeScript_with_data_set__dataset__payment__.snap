export const paymentStatusMachine = {
    "id": "PaymentStatusMachine",
    "initial": "unpaid",
    "states": {
        "unpaid": {
            "on": {
                "authorise_payment": {
                    "target": "authorised"
                }
            }
        },
        "authorised": {
            "on": {
                "capture_payment": {
                    "target": "paid"
                }
            }
        },
        "paid": {
            "on": {
                "refund": {
                    "target": "refunded"
                }
            }
        },
        "refunded": {
            "type": "final"
        }
    }
} as const;

export type PaymentStatusMachineState = "unpaid" | "authorised" | "paid" | "refunded";

export type PaymentStatusMachineEvent = { type: "authorise_payment" } | { type: "capture_payment" } | { type: "refund" };
