export const paymentStatusMachine = {
    "id": "PaymentStatusMachine",
    "initial": "unpaid",
    "states": {
        "unpaid": {
            "on": {
                "authorize_payment": {
                    "target": "authorized"
                }
            }
        },
        "authorized": {
            "on": {
                "capture_payment": {
                    "target": "paid"
                }
            }
        },
        "paid": {
            "on": {
                "refund": {
                    "target": "refunded"
                }
            }
        },
        "refunded": {
            "type": "final"
        }
    }
} as const;

export type PaymentStatusMachineState = "unpaid" | "authorized" | "paid" | "refunded";

export type PaymentStatusMachineEvent = { type: "authorize_payment" } | { type: "capture_payment" } | { type: "refund" };
