{
    "id": "TicketStatusMachine",
    "initial": "open",
    "states": {
        "active": {
            "initial": "open",
            "on": {
                "close": {
                    "target": "closed"
                }
            },
            "states": {
                "open": {
                    "on": {
                        "answer": {
                            "target": "answered"
                        }
                    }
                },
                "answered": {
                    "on": {
                        "reply": {
                            "target": "open",
                            "guard": "has_message",
                            "meta": {
                                "transition": "customer_replied"
                            }
                        }
                    }
                }
            }
        },
        "closed": {
            "on": {
                "reply": {
                    "target": "#TicketStatusMachine.active.open",
                    "meta": {
                        "transition": "reopen"
                    }
                }
            }
        }
    }
}
