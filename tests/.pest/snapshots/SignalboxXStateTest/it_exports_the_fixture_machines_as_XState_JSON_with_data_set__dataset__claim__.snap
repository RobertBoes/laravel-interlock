{
    "id": "ClaimStatusMachine",
    "initial": "0",
    "states": {
        "0": {
            "on": {
                "assess": {
                    "target": "1"
                }
            }
        },
        "1": {
            "on": {
                "settle": {
                    "target": "2",
                    "guard": {
                        "type": "and",
                        "params": {
                            "guards": [
                                "has_assessment",
                                "within_policy_limit"
                            ]
                        }
                    }
                }
            }
        },
        "2": {
            "type": "final"
        }
    }
}
